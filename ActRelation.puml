@startuml
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle stickman
skinparam nodesep 50
skinparam ranksep 15

' Modern Palette & Styling
skinparam ArrowColor #475569
skinparam ArrowThickness 1.2

skinparam ActorBorderColor #1d4ed8
skinparam ActorBackgroundColor #ffffff
skinparam ActorFontColor #0f172a
skinparam ActorFontStyle bold

skinparam UsecaseBorderColor #0f172a
skinparam UsecaseBackgroundColor #f8fafc
skinparam UsecaseFontColor #0f172a
skinparam UsecaseFontStyle bold

skinparam RectangleBorderColor #1e40af
skinparam RectangleBackgroundColor #ffffff
skinparam RectangleFontColor #1e3a8a
skinparam RectangleFontStyle bold

' =====================================================
' LEFT COLUMN ACTORS GROUP
' =====================================================
together {
    actor "System Administrator" as SysAdmin
    actor "Recruiter" as Recruiter
    actor "Payroll Administrator" as PayrollAdmin
    actor "Department Manager" as DeptManager
    actor "Project Manager" as ProjectManager
}

' =====================================================
' CENTER SYSTEM BOUNDARY
' =====================================================
rectangle "HR Enterprise Platform" {
    usecase "Platform Services" as Platform
    usecase "Compliance & Audit" as Compliance
    usecase "Recruitment & Hiring" as Recruitment
    usecase "Time & Attendance" as Time
    usecase "Core HR & Directory" as CoreHR
    usecase "Payroll & Compensation" as Payroll
    usecase "Analytics & BI Reporting" as Analytics
    usecase "Performance & OKRs" as Performance
    usecase "Workforce Tracking" as Tracking
    usecase "Projects & Resources" as Projects
}

' =====================================================
' RIGHT COLUMN ACTORS GROUP
' =====================================================
together {
    actor "Candidate" as Candidate
    actor "HR Manager" as HR
    actor "Employee" as Employee
}

' =====================================================
' VERTICAL LAYOUT ORDERING
' =====================================================
SysAdmin -[hidden]down- Recruiter
Recruiter -[hidden]down- PayrollAdmin
PayrollAdmin -[hidden]down- DeptManager
DeptManager -[hidden]down- ProjectManager

Platform -[hidden]down- Compliance
Compliance -[hidden]down- Recruitment
Recruitment -[hidden]down- Time
Time -[hidden]down- CoreHR
CoreHR -[hidden]down- Payroll
Payroll -[hidden]down- Analytics
Analytics -[hidden]down- Performance
Performance -[hidden]down- Tracking
Tracking -[hidden]down- Projects

Candidate -[hidden]down- HR
HR -[hidden]down- Employee

' =====================================================
' HORIZONTAL COLUMN ALIGNMENT
' =====================================================
SysAdmin -[hidden]right- Platform
Platform -[hidden]right- Candidate

Recruiter -[hidden]right- Recruitment
PayrollAdmin -[hidden]right- CoreHR
DeptManager -[hidden]right- Analytics
ProjectManager -[hidden]right- Projects

' =====================================================
' CONNECTIONS FROM LEFT ACTORS (-right-)
' =====================================================
SysAdmin -right- Platform
SysAdmin -right- Compliance

Recruiter -right- Recruitment
Recruiter -right- CoreHR
Recruiter -right- Analytics

PayrollAdmin -right- Time
PayrollAdmin -right- CoreHR
PayrollAdmin -right- Payroll
PayrollAdmin -right- Analytics

DeptManager -right- Recruitment
DeptManager -right- Time
DeptManager -right- CoreHR
DeptManager -right- Analytics
DeptManager -right- Performance

ProjectManager -right- Time
ProjectManager -right- Analytics
ProjectManager -right- Performance
ProjectManager -right- Tracking
ProjectManager -right- Projects

' =====================================================
' CONNECTIONS FROM RIGHT ACTORS (-left-)
' =====================================================
Candidate -left- Recruitment

HR -left- Compliance
HR -left- Recruitment
HR -left- Time
HR -left- CoreHR
HR -left- Payroll
HR -left- Analytics
HR -left- Performance
HR -left- Tracking

Employee -left- Time
Employee -left- CoreHR
Employee -left- Payroll
Employee -left- Performance
Employee -left- Tracking
Employee -left- Projects

@enduml