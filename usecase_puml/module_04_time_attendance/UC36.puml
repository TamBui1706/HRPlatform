@startuml
title 36. Track Leave Quotas & Accruals\nTime & Attendance / Leave Management

skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle stickman

hide stereotype

skinparam ActorBorderColor #1e293b
skinparam ActorBackgroundColor #ffffff
skinparam ActorFontColor #0f172a
skinparam ActorFontStyle bold

skinparam RectangleBorderColor #475569
skinparam RectangleBackgroundColor #ffffff
skinparam RectangleFontColor #1e293b
skinparam RectangleFontStyle bold

skinparam ArrowColor #334155
skinparam ArrowThickness 1.5

skinparam usecase {
    BackgroundColor #eff6ff
    BorderColor #2563eb
    FontColor #0f172a
    FontStyle bold
}

skinparam usecase<<Inc>> {
    BackgroundColor #ffffff
    BorderColor #64748b
    FontColor #0f172a
    FontStyle normal
}

skinparam usecase<<Ext>> {
    BackgroundColor #fffbeb
    BorderColor #d97706
    FontColor #0f172a
    FontStyle normal
}

actor "Employee" as Employee
actor "HR Manager" as HRManager

rectangle "Time & Attendance — Leave Management" {
    usecase "View Leave Quotas" as UC_Main



    Employee -- UC_Main
    HRManager -- UC_Main


}
@enduml
