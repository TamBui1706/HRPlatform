@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle stickman

skinparam ArrowColor #334155
skinparam ActorBorderColor #1d4ed8
skinparam ActorBackgroundColor #ffffff
skinparam UsecaseBorderColor #0f172a
skinparam UsecaseBackgroundColor #f8fafc
skinparam RectangleBorderColor #475569
skinparam RectangleBackgroundColor #ffffff

actor "Recruiter" as Recruiter
actor "HR Manager" as HRManager
actor "Candidate" as Candidate

rectangle "Recruitment & Hiring - Onboarding Hub" {
    usecase "UC35: Generate & Send Job Offer" as UC_Main
    usecase "Populate Offer Template" as UC_OfferPDF
    usecase "Approve Offer Terms" as UC_ApproveOffer
    usecase "Track Candidate Response" as UC_ResponseStatus

    Recruiter -- UC_Main
    HRManager -- UC_ApproveOffer
    UC_Main .> UC_OfferPDF : <<include>>
    UC_Main .> UC_ApproveOffer : <<include>>
    UC_Main .> UC_ResponseStatus : <<include>>
    UC_ResponseStatus -- Candidate
}
@enduml
