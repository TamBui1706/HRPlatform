@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle stickman

skinparam ArrowColor #334155
skinparam ActorBorderColor #1d4ed8
skinparam ActorBackgroundColor #ffffff
skinparam UsecaseBorderColor #0f172a
skinparam UsecaseBackgroundColor #f8fafc
skinparam RectangleBorderColor #475569
skinparam RectangleBackgroundColor #ffffff

actor "Department Manager" as DepartmentManager
actor "Recruiter" as Recruiter
actor "HR Manager" as HRManager

rectangle "Recruitment & Hiring - Candidate Connect" {
    usecase "UC34: Submit Scorecards & Feedback" as UC_Main
    usecase "Fill Criteria Scorecard" as UC_ScoreCriteria
    usecase "Write Interview Remarks" as UC_WriteFeedback
    usecase "Submit Final Recommendation" as UC_SubmitRec

    DepartmentManager -- UC_Main
    Recruiter -- UC_Main
    UC_Main .> UC_ScoreCriteria : <<include>>
    UC_Main .> UC_WriteFeedback : <<include>>
    UC_Main .> UC_SubmitRec : <<include>>
    UC_SubmitRec -- HRManager
}
@enduml
