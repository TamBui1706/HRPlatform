@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle stickman

skinparam ArrowColor #334155
skinparam ActorBorderColor #1d4ed8
skinparam ActorBackgroundColor #ffffff
skinparam UsecaseBorderColor #0f172a
skinparam UsecaseBackgroundColor #f8fafc
skinparam RectangleBorderColor #475569
skinparam RectangleBackgroundColor #ffffff

actor "Recruiter" as Recruiter
actor "Candidate" as Candidate

rectangle "Recruitment & Hiring - Recruitment Pipeline" {
    usecase "UC31: Parse & Filter Applications" as UC_Main
    usecase "Extract CV Data via Parser" as UC_ExtractCV
    usecase "Match Candidate Skills" as UC_MatchSkills
    usecase "Rank Match Percentage" as UC_RankCandidates

    Candidate -- UC_ExtractCV
    Recruiter -- UC_Main
    UC_Main .> UC_ExtractCV : <<include>>
    UC_Main .> UC_MatchSkills : <<include>>
    UC_Main .> UC_RankCandidates : <<include>>
}
@enduml
