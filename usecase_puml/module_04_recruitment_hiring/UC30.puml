@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle stickman

skinparam ArrowColor #334155
skinparam ActorBorderColor #1d4ed8
skinparam ActorBackgroundColor #ffffff
skinparam ActorFontColor #0f172a
skinparam ActorFontStyle bold

skinparam UsecaseBorderColor #0f172a
skinparam UsecaseBackgroundColor #f8fafc
skinparam UsecaseFontColor #0f172a
skinparam UsecaseFontStyle bold

skinparam RectangleBorderColor #475569
skinparam RectangleBackgroundColor #ffffff

actor "Recruiter" as Recruiter
actor "Candidate" as Candidate

rectangle "Recruitment & Hiring - Recruitment Pipeline" {
    usecase "UC30: Post Jobs to Career Portal" as UC_Main
    usecase "Edit Public Job Details" as UC_EditPosting
    usecase "Set Posting Expiry Date" as UC_SetExpiry
    usecase "Publish to Career Site" as UC_PublishJob

    Recruiter -- UC_Main
    Candidate -- UC_PublishJob
    UC_Main .> UC_EditPosting : <<include>>
    UC_Main .> UC_SetExpiry : <<include>>
    UC_Main .> UC_PublishJob : <<include>>
}
@enduml
