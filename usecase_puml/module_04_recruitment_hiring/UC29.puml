@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle stickman

skinparam ArrowColor #334155
skinparam ActorBorderColor #1d4ed8
skinparam ActorBackgroundColor #ffffff
skinparam UsecaseBorderColor #0f172a
skinparam UsecaseBackgroundColor #f8fafc
skinparam RectangleBorderColor #475569
skinparam RectangleBackgroundColor #ffffff

actor "Recruiter" as Recruiter
actor "Department Manager" as DepartmentManager
actor "HR Manager" as HRManager
actor "Finance Manager" as FinanceManager

rectangle "Recruitment & Hiring - Recruitment Pipeline" {
    usecase "UC29: Create & Approve Job Requisitions" as UC_Main
    usecase "Draft Job Requisition" as UC_DraftReq
    usecase "Route Approval Chain" as UC_RouteChain
    usecase "Approve Requisition Budget" as UC_ApproveBud

    Recruiter -- UC_Main
    DepartmentManager -- UC_DraftReq
    UC_Main .> UC_DraftReq : <<include>>
    UC_Main .> UC_RouteChain : <<include>>
    UC_Main .> UC_ApproveBud : <<include>>
    UC_ApproveBud -- FinanceManager
    UC_RouteChain -- HRManager
}
@enduml
