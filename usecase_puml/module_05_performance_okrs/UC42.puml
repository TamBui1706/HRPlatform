@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle stickman

skinparam ArrowColor #334155
skinparam ActorBorderColor #1d4ed8
skinparam ActorBackgroundColor #ffffff
skinparam UsecaseBorderColor #0f172a
skinparam UsecaseBackgroundColor #f8fafc
skinparam RectangleBorderColor #475569
skinparam RectangleBackgroundColor #ffffff

actor "Employee" as Employee
actor "Company Social Feed" as CompanySocialFeed

rectangle "Performance & OKRs - Rewards & Kudos" {
    usecase "UC42: Send Peer Recognition & Kudos" as UC_Main
    usecase "Select Kudos Badge" as UC_SelectBadge
    usecase "Attach Recognition Message" as UC_AttachMsg
    usecase "Publish to Social Feed" as UC_PubFeed

    Employee -- UC_Main
    UC_Main .> UC_SelectBadge : <<include>>
    UC_Main .> UC_AttachMsg : <<include>>
    UC_Main .> UC_PubFeed : <<include>>
    UC_PubFeed -- CompanySocialFeed
}
@enduml
