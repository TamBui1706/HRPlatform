@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle stickman

skinparam ArrowColor #334155
skinparam ActorBorderColor #1d4ed8
skinparam ActorBackgroundColor #ffffff
skinparam UsecaseBorderColor #0f172a
skinparam UsecaseBackgroundColor #f8fafc
skinparam RectangleBorderColor #475569
skinparam RectangleBackgroundColor #ffffff

actor "Employee" as Employee
actor "HR Manager" as HRManager
actor "Department Manager" as DepartmentManager

rectangle "Performance & OKRs - 360 Reviews" {
    usecase "UC40: Submit Peer & Self Appraisals" as UC_Main
    usecase "Complete Self-Appraisal" as UC_SelfApp
    usecase "Rate Peer Competencies" as UC_RatePeer
    usecase "Submit Feedback Comments" as UC_SubComments

    Employee -- UC_Main
    UC_Main .> UC_SelfApp : <<include>>
    UC_Main .> UC_RatePeer : <<include>>
    UC_Main .> UC_SubComments : <<include>>
    UC_SubComments -- HRManager
    UC_SubComments -- DepartmentManager
}
@enduml
