@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle stickman

skinparam ArrowColor #334155
skinparam ActorBorderColor #1d4ed8
skinparam ActorBackgroundColor #ffffff
skinparam UsecaseBorderColor #0f172a
skinparam UsecaseBackgroundColor #f8fafc
skinparam RectangleBorderColor #475569
skinparam RectangleBackgroundColor #ffffff

actor "HR Manager" as HRManager
actor "Employee" as Employee
actor "Department Manager" as DepartmentManager

rectangle "Performance & OKRs - 360 Reviews" {
    usecase "UC39: Initiate 360 Reviews" as UC_Main
    usecase "Setup Review Campaign" as UC_SetupCam
    usecase "Assign Peer Reviewers" as UC_AssignPeers
    usecase "Dispatch Evaluation Forms" as UC_DispatchForms

    HRManager -- UC_Main
    UC_Main .> UC_SetupCam : <<include>>
    UC_Main .> UC_AssignPeers : <<include>>
    UC_Main .> UC_DispatchForms : <<include>>
    UC_DispatchForms -- Employee
    UC_DispatchForms -- DepartmentManager
}
@enduml
