@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle stickman

skinparam ArrowColor #334155
skinparam ActorBorderColor #1d4ed8
skinparam ActorBackgroundColor #ffffff
skinparam UsecaseBorderColor #0f172a
skinparam UsecaseBackgroundColor #f8fafc
skinparam RectangleBorderColor #475569
skinparam RectangleBackgroundColor #ffffff

actor "Department Manager" as DepartmentManager
actor "Employee" as Employee

rectangle "Performance & OKRs - 1-on-1 Coaching" {
    usecase "UC41: Record 1-on-1 Coaching Notes" as UC_Main
    usecase "Schedule 1-on-1 Session" as UC_SchedSes
    usecase "Log Coaching Discussion" as UC_LogNotes
    usecase "Assign Action Items" as UC_AssignAct

    DepartmentManager -- UC_Main
    Employee -- UC_Main
    UC_Main .> UC_SchedSes : <<include>>
    UC_Main .> UC_LogNotes : <<include>>
    UC_Main .> UC_AssignAct : <<include>>
}
@enduml
