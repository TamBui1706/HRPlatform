@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle stickman

skinparam ArrowColor #334155
skinparam ActorBorderColor #1d4ed8
skinparam ActorBackgroundColor #ffffff
skinparam ActorFontColor #0f172a
skinparam ActorFontStyle bold

skinparam UsecaseBorderColor #0f172a
skinparam UsecaseBackgroundColor #f8fafc
skinparam UsecaseFontColor #0f172a
skinparam UsecaseFontStyle bold

skinparam RectangleBorderColor #475569
skinparam RectangleBackgroundColor #ffffff

actor "Department Manager" as DepartmentManager
actor "Employee" as Employee
actor "HR Manager" as HRManager

rectangle "Performance & OKRs - Goals & OKRs" {
    usecase "UC37: Align Goals & OKRs" as UC_Main
    usecase "Create Strategic Objective" as UC_StratObj
    usecase "Cascade Department OKR" as UC_DeptOKR
    usecase "Link Individual Key Results" as UC_IndivOKR

    HRManager -- UC_StratObj
    DepartmentManager -- UC_Main
    Employee -- UC_IndivOKR
    UC_Main .> UC_StratObj : <<include>>
    UC_Main .> UC_DeptOKR : <<include>>
    UC_Main .> UC_IndivOKR : <<include>>
}
@enduml
