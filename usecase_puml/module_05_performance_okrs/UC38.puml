@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle stickman

skinparam ArrowColor #334155
skinparam ActorBorderColor #1d4ed8
skinparam ActorBackgroundColor #ffffff
skinparam ActorFontColor #0f172a
skinparam ActorFontStyle bold

skinparam UsecaseBorderColor #0f172a
skinparam UsecaseBackgroundColor #f8fafc
skinparam UsecaseFontColor #0f172a
skinparam UsecaseFontStyle bold

skinparam RectangleBorderColor #475569
skinparam RectangleBackgroundColor #ffffff

actor "Employee" as Employee
actor "Department Manager" as DepartmentManager

rectangle "Performance & OKRs - Goals & OKRs" {
    usecase "UC38: Update Key Result Progress" as UC_Main
    usecase "Input Current Metric Value" as UC_InputVal
    usecase "Calculate % Goal Completion" as UC_CalcComp
    usecase "Flag Progress Blockers" as UC_FlagBlock

    Employee -- UC_Main
    DepartmentManager -- UC_FlagBlock
    UC_Main .> UC_InputVal : <<include>>
    UC_Main .> UC_CalcComp : <<include>>
    UC_Main .> UC_FlagBlock : <<include>>
}
@enduml
