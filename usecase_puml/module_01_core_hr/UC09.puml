@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle stickman

skinparam ArrowColor #334155
skinparam ActorBorderColor #1d4ed8
skinparam ActorBackgroundColor #ffffff
skinparam UsecaseBorderColor #0f172a
skinparam UsecaseBackgroundColor #f8fafc
skinparam RectangleBorderColor #475569
skinparam RectangleBackgroundColor #ffffff

actor "Employee" as Employee
actor "HR Manager" as HRManager
actor "Tax Authority Portal" as TaxAuthorityPortal

rectangle "Core HR & Employee Management - Employee Directory" {
    usecase "UC09: Register Tax Dependents" as UC_Main
    usecase "Fill Dependent Registration Form" as UC_FillForm
    usecase "Attach Birth Certificate/Proof" as UC_AttachProof
    usecase "Approve Tax Reduction Status" as UC_ApproveTax

    Employee -- UC_Main
    HRManager -- UC_ApproveTax
    UC_Main .> UC_FillForm : <<include>>
    UC_Main .> UC_AttachProof : <<include>>
    UC_Main .> UC_ApproveTax : <<include>>
    UC_ApproveTax -- TaxAuthorityPortal
}
@enduml
