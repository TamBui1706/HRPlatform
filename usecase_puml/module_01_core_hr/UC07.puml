@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle stickman

skinparam ArrowColor #334155
skinparam ActorBorderColor #1d4ed8
skinparam ActorBackgroundColor #ffffff
skinparam UsecaseBorderColor #0f172a
skinparam UsecaseBackgroundColor #f8fafc
skinparam RectangleBorderColor #475569
skinparam RectangleBackgroundColor #ffffff

actor "HR Manager" as HRManager
actor "Employee" as Employee
actor "Department Manager" as DepartmentManager

rectangle "Core HR & Employee Management - Document Vault" {
    usecase "UC07: Track Contract Expirations" as UC_Main
    usecase "Scan Expiring Contracts" as UC_Scan
    usecase "Trigger Expiry Alert" as UC_Alert
    usecase "Initiate Contract Renewal" as UC_Renew

    HRManager -- UC_Main
    UC_Main .> UC_Scan : <<include>>
    UC_Main .> UC_Alert : <<include>>
    UC_Main .> UC_Renew : <<include>>
    UC_Alert -- Employee
    UC_Renew -- DepartmentManager
}
@enduml
