@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle stickman

skinparam ArrowColor #334155
skinparam ActorBorderColor #1d4ed8
skinparam ActorBackgroundColor #ffffff
skinparam ActorFontColor #0f172a
skinparam ActorFontStyle bold

skinparam UsecaseBorderColor #0f172a
skinparam UsecaseBackgroundColor #f8fafc
skinparam UsecaseFontColor #0f172a
skinparam UsecaseFontStyle bold

skinparam RectangleBorderColor #475569
skinparam RectangleBackgroundColor #ffffff

actor "HR Manager" as HRManager
actor "Department Manager" as DepartmentManager
actor "Employee" as Employee

rectangle "Core HR & Employee Management - Employee Directory" {
    usecase "UC05: Update Probation & Offboarding Status" as UC_Main
    usecase "Evaluate Probation Result" as UC_Prob
    usecase "Convert to Official Employee" as UC_Official
    usecase "Lock Resigned User Account" as UC_LockAcc

    HRManager -- UC_Main
    DepartmentManager -- UC_Prob
    Employee -- UC_LockAcc
    UC_Main .> UC_Prob : <<include>>
    UC_Main .> UC_Official : <<include>>
    UC_LockAcc .> UC_Main : <<extend>>
}
@enduml
