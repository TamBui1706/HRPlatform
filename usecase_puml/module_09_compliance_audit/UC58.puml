@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle stickman

skinparam ArrowColor #334155
skinparam ActorBorderColor #1d4ed8
skinparam ActorBackgroundColor #ffffff
skinparam UsecaseBorderColor #0f172a
skinparam UsecaseBackgroundColor #f8fafc
skinparam RectangleBorderColor #475569
skinparam RectangleBackgroundColor #ffffff

actor "HR Manager" as HRManager
actor "Legal Department" as LegalDepartment
actor "Labor Inspector" as LaborInspector

rectangle "Compliance & Audit - Regulatory Compliance" {
    usecase "UC58: Audit Labor Law Compliance" as UC_Main
    usecase "Run Compliance Rule Scan" as UC_ScanRule
    usecase "Flag Overtime & Contract Risks" as UC_FlagRisk
    usecase "Export Regulatory Audit Report" as UC_ExportAudit

    HRManager -- UC_Main
    LegalDepartment -- UC_Main
    UC_Main .> UC_ScanRule : <<include>>
    UC_Main .> UC_FlagRisk : <<include>>
    UC_Main .> UC_ExportAudit : <<include>>
    UC_ExportAudit -- LaborInspector
}
@enduml
