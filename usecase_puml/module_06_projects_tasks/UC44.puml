@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle stickman

skinparam ArrowColor #334155
skinparam ActorBorderColor #1d4ed8
skinparam ActorBackgroundColor #ffffff
skinparam UsecaseBorderColor #0f172a
skinparam UsecaseBackgroundColor #f8fafc
skinparam RectangleBorderColor #475569
skinparam RectangleBackgroundColor #ffffff

actor "Project Manager" as ProjectManager
actor "Employee" as Employee
actor "Department Manager" as DepartmentManager

rectangle "Projects & Task Management - Project Lifecycle" {
    usecase "UC44: Assign Team Members to Projects" as UC_Main
    usecase "Select Project Members" as UC_SelectMem
    usecase "Set Allocation Percentage" as UC_SetAlloc
    usecase "Notify Resource Assignment" as UC_NotifyAssign

    ProjectManager -- UC_Main
    DepartmentManager -- UC_Main
    UC_Main .> UC_SelectMem : <<include>>
    UC_Main .> UC_SetAlloc : <<include>>
    UC_Main .> UC_NotifyAssign : <<include>>
    UC_NotifyAssign -- Employee
}
@enduml
