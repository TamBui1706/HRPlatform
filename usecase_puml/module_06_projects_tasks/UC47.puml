@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle stickman

skinparam ArrowColor #334155
skinparam ActorBorderColor #1d4ed8
skinparam ActorBackgroundColor #ffffff
skinparam ActorFontColor #0f172a
skinparam ActorFontStyle bold

skinparam UsecaseBorderColor #0f172a
skinparam UsecaseBackgroundColor #f8fafc
skinparam UsecaseFontColor #0f172a
skinparam UsecaseFontStyle bold

skinparam RectangleBorderColor #475569
skinparam RectangleBackgroundColor #ffffff

actor "Project Manager" as ProjectManager
actor "Department Manager" as DepartmentManager

rectangle "Projects & Task Management - Financial Cost Control" {
    usecase "UC47: Manage Project Expenses & Billing" as UC_Main
    usecase "Log Non-Labor Expense" as UC_LogExpense
    usecase "Generate Client Invoice Draft" as UC_DraftBill
    usecase "Export Billing Summary" as UC_ExportSummary

    ProjectManager -- UC_Main
    DepartmentManager -- UC_DraftBill
    UC_Main .> UC_LogExpense : <<include>>
    UC_Main .> UC_DraftBill : <<include>>
    UC_Main .> UC_ExportSummary : <<include>>
}
@enduml
