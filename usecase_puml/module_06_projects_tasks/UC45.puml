@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle stickman

skinparam ArrowColor #334155
skinparam ActorBorderColor #1d4ed8
skinparam ActorBackgroundColor #ffffff
skinparam UsecaseBorderColor #0f172a
skinparam UsecaseBackgroundColor #f8fafc
skinparam RectangleBorderColor #475569
skinparam RectangleBackgroundColor #ffffff

actor "Project Manager" as ProjectManager
actor "Employee" as Employee

rectangle "Projects & Task Management - Task & Milestone Management" {
    usecase "UC45: Assign & Track Project Tasks" as UC_Main
    usecase "Create Task Item" as UC_CreateTask
    usecase "Update Task Status" as UC_UpdateTask
    usecase "Render Gantt Chart Timeline" as UC_Gantt

    ProjectManager -- UC_Main
    Employee -- UC_UpdateTask
    UC_Main .> UC_CreateTask : <<include>>
    UC_Main .> UC_UpdateTask : <<include>>
    UC_Main .> UC_Gantt : <<include>>
}
@enduml
