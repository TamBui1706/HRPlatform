@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle stickman

skinparam ArrowColor #334155
skinparam ActorBorderColor #1d4ed8
skinparam ActorBackgroundColor #ffffff
skinparam UsecaseBorderColor #0f172a
skinparam UsecaseBackgroundColor #f8fafc
skinparam RectangleBorderColor #475569
skinparam RectangleBackgroundColor #ffffff

actor "Payroll Administrator" as PayrollAdministrator
actor "Department Manager" as DepartmentManager

rectangle "Payroll & Compensation - Compensation Matrix" {
    usecase "UC25: Calculate Bonuses & Commissions" as UC_Main
    usecase "Import Sales Metric" as UC_ImportMetrics
    usecase "Apply Tiered Commission Matrix" as UC_ApplyMatrix
    usecase "Consolidate Bonus Payout" as UC_ConsolidateBonus

    PayrollAdministrator -- UC_Main
    DepartmentManager -- UC_ImportMetrics
    UC_Main .> UC_ImportMetrics : <<include>>
    UC_Main .> UC_ApplyMatrix : <<include>>
    UC_Main .> UC_ConsolidateBonus : <<include>>
}
@enduml
