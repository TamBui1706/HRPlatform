@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle stickman

skinparam ArrowColor #334155
skinparam ActorBorderColor #1d4ed8
skinparam ActorBackgroundColor #ffffff
skinparam ActorFontColor #0f172a
skinparam ActorFontStyle bold

skinparam UsecaseBorderColor #0f172a
skinparam UsecaseBackgroundColor #f8fafc
skinparam UsecaseFontColor #0f172a
skinparam UsecaseFontStyle bold

skinparam RectangleBorderColor #475569
skinparam RectangleBackgroundColor #ffffff

actor "Payroll Administrator" as PayrollAdministrator
actor "HR Manager" as HRManager

rectangle "Payroll & Compensation - Compensation Matrix" {
    usecase "UC24: Configure Tax & Insurance Rules" as UC_Main
    usecase "Update Personal Tax Brackets" as UC_UpdateTax
    usecase "Set Insurance Contribution %" as UC_SetRates
    usecase "Test Salary Calculation Formula" as UC_TestForm

    PayrollAdministrator -- UC_Main
    HRManager -- UC_Main
    UC_Main .> UC_UpdateTax : <<include>>
    UC_Main .> UC_SetRates : <<include>>
    UC_Main .> UC_TestForm : <<include>>
}
@enduml
