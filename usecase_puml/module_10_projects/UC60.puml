@startuml
title 60. Manage Project Allocations & Cost Tracking\nProject Control / Resource Allocation

skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle stickman

hide stereotype

skinparam ActorBorderColor #1e293b
skinparam ActorBackgroundColor #ffffff
skinparam ActorFontColor #0f172a
skinparam ActorFontStyle bold

skinparam RectangleBorderColor #475569
skinparam RectangleBackgroundColor #ffffff
skinparam RectangleFontColor #1e293b
skinparam RectangleFontStyle bold

skinparam ArrowColor #334155
skinparam ArrowThickness 1.5

skinparam usecase {
    BackgroundColor #eff6ff
    BorderColor #2563eb
    FontColor #0f172a
    FontStyle bold
}

skinparam usecase<<Inc>> {
    BackgroundColor #ffffff
    BorderColor #64748b
    FontColor #0f172a
    FontStyle normal
}

skinparam usecase<<Ext>> {
    BackgroundColor #fffbeb
    BorderColor #d97706
    FontColor #0f172a
    FontStyle normal
}

actor "Project Manager" as ProjectManager
actor "Department Manager" as DepartmentManager
actor "Employee" as Employee

rectangle "Project Control — Resource Allocation" {
    usecase "Manage Project & Cost" as UC_Main

    usecase "Set Project Budget Pool" as UC_Inc1 <<Inc>>
    usecase "Assign Team Members" as UC_Inc2 <<Inc>>

    usecase "Set Cost Overrun Warning" as UC_Ext1 <<Ext>>

    ProjectManager -- UC_Main
    DepartmentManager -- UC_Main
    Employee -- UC_Main

    UC_Main .[#2563eb].> UC_Inc1 : <<include>>
    UC_Main .[#2563eb].> UC_Inc2 : <<include>>

    UC_Ext1 .[#d97706].> UC_Main : <<extend>>
}
@enduml
