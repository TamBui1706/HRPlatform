@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle stickman

skinparam ArrowColor #334155
skinparam ActorBorderColor #1d4ed8
skinparam ActorBackgroundColor #ffffff
skinparam UsecaseBorderColor #0f172a
skinparam UsecaseBackgroundColor #f8fafc
skinparam RectangleBorderColor #475569
skinparam RectangleBackgroundColor #ffffff

actor "System Administrator" as SystemAdministrator
actor "Database Administrator" as DatabaseAdministrator
actor "Security Engine" as SecurityEngine

rectangle "Platform & Security (Web) - Data Privacy & Security" {
    usecase "UC53: Configure Data Masking & Encryption" as UC_Main
    usecase "Select Sensitive PII Fields" as UC_SelectPII
    usecase "Define Dynamic Masking Rules" as UC_MaskRule
    usecase "Execute Field Encryption AES-256" as UC_EncryptDB

    SystemAdministrator -- UC_Main
    DatabaseAdministrator -- UC_EncryptDB
    UC_Main .> UC_SelectPII : <<include>>
    UC_Main .> UC_MaskRule : <<include>>
    UC_Main .> UC_EncryptDB : <<include>>
    UC_EncryptDB -- SecurityEngine
}
@enduml
