@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle stickman

skinparam ArrowColor #334155
skinparam ActorBorderColor #1d4ed8
skinparam ActorBackgroundColor #ffffff
skinparam ActorFontColor #0f172a
skinparam ActorFontStyle bold

skinparam UsecaseBorderColor #0f172a
skinparam UsecaseBackgroundColor #f8fafc
skinparam UsecaseFontColor #0f172a
skinparam UsecaseFontStyle bold

skinparam RectangleBorderColor #475569
skinparam RectangleBackgroundColor #ffffff

actor "System Administrator" as SystemAdministrator
actor "HR Manager" as HRManager

rectangle "Platform & Security (Web) - Authentication & IAM" {
    usecase "UC50: Manage Roles & Permissions" as UC_Main
    usecase "Define Role CRUD Matrix" as UC_MatrixCRUD
    usecase "Assign Data Scope Boundaries" as UC_ScopeData
    usecase "Flush Permission Cache" as UC_FlushCache

    SystemAdministrator -- UC_Main
    HRManager -- UC_Main
    UC_Main .> UC_MatrixCRUD : <<include>>
    UC_Main .> UC_ScopeData : <<include>>
    UC_Main .> UC_FlushCache : <<include>>
}
@enduml
