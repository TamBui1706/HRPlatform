@startuml
title 26. Complete New-Hire Onboarding Tasks\nRecruitment / Talent Onboarding

skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle stickman

hide stereotype

skinparam ActorBorderColor #1e293b
skinparam ActorBackgroundColor #ffffff
skinparam ActorFontColor #0f172a
skinparam ActorFontStyle bold

skinparam RectangleBorderColor #475569
skinparam RectangleBackgroundColor #ffffff
skinparam RectangleFontColor #1e293b
skinparam RectangleFontStyle bold

skinparam ArrowColor #334155
skinparam ArrowThickness 1.5

skinparam usecase {
    BackgroundColor #eff6ff
    BorderColor #2563eb
    FontColor #0f172a
    FontStyle bold
}

skinparam usecase<<Inc>> {
    BackgroundColor #ffffff
    BorderColor #64748b
    FontColor #0f172a
    FontStyle normal
}

skinparam usecase<<Ext>> {
    BackgroundColor #fffbeb
    BorderColor #d97706
    FontColor #0f172a
    FontStyle normal
}

actor "Candidate" as Candidate
actor "Employee" as Employee
actor "HR Manager" as HRManager

rectangle "Recruitment — Talent Onboarding" {
    usecase "Complete Onboarding Tasks" as UC_Main

    usecase "Submit Pre-hire Information" as UC_Inc1 <<Inc>>

    usecase "Issue Employee Access Card" as UC_Ext1 <<Ext>>

    Candidate -- UC_Main
    Employee -- UC_Main
    HRManager -- UC_Main

    UC_Main .[#2563eb].> UC_Inc1 : <<include>>

    UC_Ext1 .[#d97706].> UC_Main : <<extend>>
}
@enduml
