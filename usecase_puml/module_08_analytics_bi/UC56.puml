@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle stickman

skinparam ArrowColor #334155
skinparam ActorBorderColor #1d4ed8
skinparam ActorBackgroundColor #ffffff
skinparam ActorFontColor #0f172a
skinparam ActorFontStyle bold

skinparam UsecaseBorderColor #0f172a
skinparam UsecaseBackgroundColor #f8fafc
skinparam UsecaseFontColor #0f172a
skinparam UsecaseFontStyle bold

skinparam RectangleBorderColor #475569
skinparam RectangleBackgroundColor #ffffff

actor "HR Manager" as HRManager
actor "Department Manager" as DepartmentManager
actor "Payroll Administrator" as PayrollAdministrator

rectangle "Analytics & BI Reporting - Executive Dashboards" {
    usecase "UC56: View Headcount & Cost Dashboard" as UC_Main
    usecase "Render Headcount Chart" as UC_RenderHC
    usecase "Calculate Total Payroll Cost" as UC_CalcCost
    usecase "Compare Budget vs Actual" as UC_CompBud

    HRManager -- UC_Main
    DepartmentManager -- UC_Main
    PayrollAdministrator -- UC_CalcCost
    UC_Main .> UC_RenderHC : <<include>>
    UC_Main .> UC_CalcCost : <<include>>
    UC_Main .> UC_CompBud : <<include>>
}
@enduml
