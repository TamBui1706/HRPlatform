@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle stickman

skinparam ArrowColor #334155
skinparam ActorBorderColor #1d4ed8
skinparam ActorBackgroundColor #ffffff
skinparam UsecaseBorderColor #0f172a
skinparam UsecaseBackgroundColor #f8fafc
skinparam RectangleBorderColor #475569
skinparam RectangleBackgroundColor #ffffff

actor "HR Manager" as HRManager
actor "Department Manager" as DepartmentManager

rectangle "Analytics & BI Reporting - Executive Dashboards" {
    usecase "UC57: Analyze Turnover & Retention" as UC_Main
    usecase "Calculate Turnover Rate" as UC_CalcTurn
    usecase "Group Exit Reasons" as UC_GroupReas
    usecase "Render Retention Trends" as UC_RenderTrend

    HRManager -- UC_Main
    UC_Main .> UC_CalcTurn : <<include>>
    UC_Main .> UC_GroupReas : <<include>>
    UC_Main .> UC_RenderTrend : <<include>>
    UC_RenderTrend -- DepartmentManager
}
@enduml
