@startuml
title 37. Execute Monthly Payroll Computation\nPayroll & Benefits / Payroll Engine

skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle stickman

hide stereotype

skinparam ActorBorderColor #1e293b
skinparam ActorBackgroundColor #ffffff
skinparam ActorFontColor #0f172a
skinparam ActorFontStyle bold

skinparam RectangleBorderColor #475569
skinparam RectangleBackgroundColor #ffffff
skinparam RectangleFontColor #1e293b
skinparam RectangleFontStyle bold

skinparam ArrowColor #334155
skinparam ArrowThickness 1.5

skinparam usecase {
    BackgroundColor #eff6ff
    BorderColor #2563eb
    FontColor #0f172a
    FontStyle bold
}

skinparam usecase<<Inc>> {
    BackgroundColor #ffffff
    BorderColor #64748b
    FontColor #0f172a
    FontStyle normal
}

skinparam usecase<<Ext>> {
    BackgroundColor #fffbeb
    BorderColor #d97706
    FontColor #0f172a
    FontStyle normal
}

actor "Payroll Administrator" as PayrollAdministrator
actor "HR Manager" as HRManager

rectangle "Payroll & Benefits — Payroll Engine" {
    usecase "Execute Payroll Computation" as UC_Main

    usecase "Compute Gross Salary" as UC_Inc1 <<Inc>>
    usecase "Deduct Tax & Insurance" as UC_Inc2 <<Inc>>

    usecase "Calculate Sales Commissions" as UC_Ext1 <<Ext>>

    PayrollAdministrator -- UC_Main
    HRManager -- UC_Main

    UC_Main .[#2563eb].> UC_Inc1 : <<include>>
    UC_Main .[#2563eb].> UC_Inc2 : <<include>>

    UC_Ext1 .[#d97706].> UC_Main : <<extend>>
}
@enduml
