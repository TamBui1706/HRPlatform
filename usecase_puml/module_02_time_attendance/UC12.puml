@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle stickman

skinparam ArrowColor #334155
skinparam ActorBorderColor #1d4ed8
skinparam ActorBackgroundColor #ffffff
skinparam ActorFontColor #0f172a
skinparam ActorFontStyle bold

skinparam UsecaseBorderColor #0f172a
skinparam UsecaseBackgroundColor #f8fafc
skinparam UsecaseFontColor #0f172a
skinparam UsecaseFontStyle bold

skinparam RectangleBorderColor #475569
skinparam RectangleBackgroundColor #ffffff

actor "Employee" as Employee
actor "Department Manager" as DepartmentManager
actor "Payroll Administrator" as PayrollAdministrator

rectangle "Time & Attendance Management - Attendance Engine" {
    usecase "UC12: Submit & Approve Overtime" as UC_Main
    usecase "Draft Overtime Form" as UC_DraftOT
    usecase "Calculate OT Coefficient" as UC_CalcCoeff
    usecase "Approve OT Hours" as UC_ApproveOT

    Employee -- UC_Main
    DepartmentManager -- UC_ApproveOT
    PayrollAdministrator -- UC_CalcCoeff
    UC_Main .> UC_DraftOT : <<include>>
    UC_Main .> UC_CalcCoeff : <<include>>
    UC_Main .> UC_ApproveOT : <<include>>
}
@enduml
