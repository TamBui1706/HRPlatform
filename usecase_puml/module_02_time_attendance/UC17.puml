@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle stickman

skinparam ArrowColor #334155
skinparam ActorBorderColor #1d4ed8
skinparam ActorBackgroundColor #ffffff
skinparam UsecaseBorderColor #0f172a
skinparam UsecaseBackgroundColor #f8fafc
skinparam RectangleBorderColor #475569
skinparam RectangleBackgroundColor #ffffff

actor "Employee" as Employee
actor "Department Manager" as DepartmentManager

rectangle "Time & Attendance Management - Timesheet Hub" {
    usecase "UC17: Submit Attendance Discrepancy" as UC_Main
    usecase "Detect Missing Punch Date" as UC_DetectMissing
    usecase "Fill Discrepancy Reason" as UC_FillReason
    usecase "Approve Attendance Adjustment" as UC_ApproveDisc

    Employee -- UC_Main
    UC_Main .> UC_DetectMissing : <<include>>
    UC_Main .> UC_FillReason : <<include>>
    UC_Main .> UC_ApproveDisc : <<include>>
    UC_ApproveDisc -- DepartmentManager
}
@enduml
