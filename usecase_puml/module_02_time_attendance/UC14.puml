@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam actorStyle stickman

skinparam ArrowColor #334155
skinparam ActorBorderColor #1d4ed8
skinparam ActorBackgroundColor #ffffff
skinparam UsecaseBorderColor #0f172a
skinparam UsecaseBackgroundColor #f8fafc
skinparam RectangleBorderColor #475569
skinparam RectangleBackgroundColor #ffffff

actor "Employee" as Employee
actor "HR Manager" as HRManager

rectangle "Time & Attendance Management - Absence & Leave" {
    usecase "UC14: Check Leave Balance & History" as UC_Main
    usecase "Calculate Leave Entitlement" as UC_CalcBal
    usecase "Render Absence History Grid" as UC_RenderHist
    usecase "Export Leave Summary PDF" as UC_ExportPdf

    Employee -- UC_Main
    UC_Main .> UC_CalcBal : <<include>>
    UC_Main .> UC_RenderHist : <<include>>
    UC_Main .> UC_ExportPdf : <<include>>
    UC_Main -- HRManager
}
@enduml
