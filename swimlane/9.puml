@startuml
title Executive Dashboard & Custom BI Report Generation Workflow

skinparam shadowing false
skinparam packageStyle rectangle
skinparam ActivityBorderColor #0f172a
skinparam ActivityBackgroundColor #f8fafc
skinparam ActivityFontColor #0f172a
skinparam ActivityFontSize 12
skinparam ActivityFontStyle bold

skinparam SwimlaneBorderColor #1d4ed8
skinparam SwimlaneWidth 220
skinparam SwimlaneTitleFontColor #1e3a8a
skinparam SwimlaneTitleFontSize 14
skinparam SwimlaneTitleFontStyle bold

skinparam ArrowColor #334155
skinparam ArrowThickness 1.5

|HR Manager|
start
:Select Analytical Metrics, Filter Fields & Date Range;

|Payroll Administrator|
:Supply Headcount & Monthly Payroll Cost Data;

|HR Manager|
:Query Central Database & Aggregate Metrics;
:Render Interactive Executive Charts & Turnover Graphs;
if (Export Format Requested?) then (Export)
  :Export Data Table to Excel / PDF Format;
else (Dashboard View)
  :Save Custom Report View Template;
endif

|Department Manager|
:Inspect Executive BI Dashboard Insights;
stop
@enduml
